<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BD earning - দৈনিক ইনকাম ও ইনভেস্টমেন্ট প্ল্যাটফর্ম</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      font-family: 'Hind Siliguri', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: #e9eef5;
      margin: 0;
      padding: 0;
    }
    .app-shell {
      max-width: 440px;
      margin: 0 auto;
      min-height: 100vh;
      background-color: #f4f6fa;
      position: relative;
      box-shadow: 0 0 25px rgba(15, 42, 74, 0.12);
      padding-bottom: 82px;
    }
    .navy-gradient {
      background: linear-gradient(145deg, #102a4c 0%, #1b3f6e 100%);
    }
    .card-shadow {
      box-shadow: 0 4px 16px rgba(16, 42, 76, 0.06);
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes pulseSlow {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }
    .animate-pulse-slow {
      animation: pulseSlow 2.5s infinite;
    }
  </style>
</head>
<body>

<div class="app-shell" id="app">
  <!-- Toast Notification -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-[100] hidden bg-[#102a4c] text-white px-4 py-2.5 rounded-full shadow-lg text-sm font-medium flex items-center gap-2 border border-white/15 max-w-[90%]">
    <span id="toast-icon">✅</span>
    <span id="toast-msg">সফল হয়েছে</span>
  </div>

  <!-- AUTH SCREEN (LOGIN / REGISTER) -->
  <div id="auth-screen" class="min-h-screen flex flex-col justify-center px-5 py-8 bg-[#f4f6fa]">
    <div class="bg-white rounded-3xl p-6 card-shadow border border-slate-100">
      <!-- Brand Logo -->
      <div class="flex flex-col items-center mb-6">
        <div class="w-20 h-20 rounded-full navy-gradient flex items-center justify-center shadow-lg border-4 border-amber-400/80 mb-3 relative">
          <div class="text-center leading-none">
            <span class="text-amber-400 font-bold text-2xl tracking-tight">BD</span>
            <div class="text-[10px] text-white font-semibold tracking-wider uppercase mt-0.5">EARNING</div>
          </div>
          <span class="absolute -bottom-1 -right-1 bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">৳১০০</span>
        </div>
        <h1 class="text-2xl font-bold text-[#102a4c]">BD earning</h1>
        <p class="text-xs text-slate-500 mt-1 text-center">নতুন অ্যাকাউন্ট খুললেই সাথে সাথে <span class="text-emerald-600 font-bold">১০০ টাকা</span> স্বাগতম বোনাস!</p>
      </div>

      <!-- Tabs -->
      <div class="grid grid-cols-2 bg-slate-100 p-1 rounded-xl mb-5">
        <button id="tab-register" onclick="switchAuthMode('register')" class="py-2 text-sm font-bold rounded-lg bg-[#102a4c] text-white transition">নতুন অ্যাকাউন্ট</button>
        <button id="tab-login" onclick="switchAuthMode('login')" class="py-2 text-sm font-semibold rounded-lg text-slate-600 transition">লগইন করুন</button>
      </div>

      <!-- Register Form -->
      <form id="register-form" onsubmit="handleRegister(event)" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">আপনার পূর্ণ নাম</label>
          <input type="text" id="reg-name" required placeholder="যেমন: মো: রাকিব হাসান" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">মোবাইল নাম্বার (বিকাশ / ব্যক্তিগত)</label>
          <input type="tel" id="reg-phone" required maxlength="11" placeholder="01XXXXXXXXX" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">পাসওয়ার্ড দিন</label>
          <input type="password" id="reg-pass" required minlength="4" placeholder="কমপক্ষে ৪ সংখ্যার পাসওয়ার্ড" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">রেফারেল কোড (ঐচ্ছিক)</label>
          <input type="text" id="reg-ref" placeholder="বন্ধুর রেফার কোড থাকলে দিন" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <button type="submit" class="w-full navy-gradient text-white font-bold py-3 rounded-xl shadow-md hover:opacity-95 transition mt-2">
          অ্যাকাউন্ট খুলুন ও ১০০ টাকা বোনাস নিন
        </button>
      </form>

      <!-- Login Form -->
      <form id="login-form" onsubmit="handleLogin(event)" class="space-y-3.5 hidden">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">মোবাইল নাম্বার</label>
          <input type="tel" id="login-phone" required maxlength="11" placeholder="01XXXXXXXXX" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">পাসওয়ার্ড</label>
          <input type="password" id="login-pass" required placeholder="আপনার পাসওয়ার্ড দিন" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-[#102a4c]" />
        </div>
        <button type="submit" class="w-full navy-gradient text-white font-bold py-3 rounded-xl shadow-md hover:opacity-95 transition mt-2">
          লগইন করুন
        </button>
      </form>
    </div>
  </div>

  <!-- MAIN APP CONTAINER -->
  <div id="main-app" class="hidden">

    <!-- ==================== TAB 1: HOME (হোম) ==================== -->
    <div id="view-home" class="view-section">
      <!-- Top Header -->
      <div class="bg-white px-4 py-3 flex items-center justify-between border-b border-slate-100 sticky top-0 z-30">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-full navy-gradient flex items-center justify-center border-2 border-amber-400 shadow-sm">
            <span class="text-amber-400 font-bold text-sm">BD</span>
          </div>
          <div>
            <h1 class="text-base font-bold text-[#102a4c] leading-tight">BD earning</h1>
            <p class="text-[11px] text-emerald-600 font-semibold">অফিশিয়াল ইনকাম প্ল্যাটফর্ম</p>
          </div>
        </div>
        <button onclick="openModal('telegram-modal')" class="bg-sky-50 text-sky-700 border border-sky-200 px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.74 3.98-1.73 6.64-2.87 7.97-3.43 3.8-1.57 4.59-1.85 5.1-1.86.11 0 .37.03.54.17.14.12.18.28.2.45-.01.07-.01.24-.02.33z"/></svg>
          সাপোর্ট গ্রুপ
        </button>
      </div>

      <div class="p-4 space-y-4">
        <!-- Top Banner ("কিভাবে দ্রুত টাকা আয় করা যায়!") -->
        <div onclick="openModal('task-details-modal')" class="navy-gradient rounded-2xl p-4 text-white flex items-center justify-between cursor-pointer card-shadow">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            </div>
            <div>
              <p class="font-bold text-sm">কিভাবে দ্রুত টাকা আয় করা যায়!</p>
              <p class="text-[11px] text-slate-200">ভিআইপি প্ল্যান ও দৈনিক ইনকামের তালিকা দেখুন</p>
            </div>
          </div>
          <span class="text-lg font-bold text-amber-300">›</span>
        </div>

        <!-- Marquee Notice Bar -->
        <div class="bg-white border border-blue-200/80 rounded-xl px-3 py-2 flex items-center gap-2 card-shadow">
          <svg class="w-4 h-4 text-[#102a4c] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          <marquee class="text-xs font-medium text-[#102a4c]" scrollamount="4">
            BD earning-এ স্বাগতম! নতুন অ্যাকাউন্ট খুললেই ১০০ টাকা বোনাস। শুধুমাত্র বিকাশ সেন্ড মানি (01622932025) এর মাধ্যমে রিচার্জ করুন। সর্বনিম্ন রিচার্জ ১০০০ টাকা এবং সর্বনিম্ন উত্তোলন ২০০ টাকা। ১০ জন বন্ধুকে রেফার করলেই ৫,০০০ টাকা বোনাস!
          </marquee>
        </div>

        <!-- 4 Quick Action Icons (matching screenshot) -->
        <div class="bg-white rounded-2xl p-4 card-shadow grid grid-cols-4 gap-2 text-center">
          <button onclick="openModal('recharge-modal')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-11 h-11 rounded-xl bg-slate-100 group-hover:bg-[#102a4c] group-hover:text-white text-[#102a4c] flex items-center justify-center transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            </div>
            <span class="text-xs font-semibold text-slate-700">রিচার্জ</span>
          </button>

          <button onclick="openModal('withdraw-modal')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-11 h-11 rounded-xl bg-slate-100 group-hover:bg-[#102a4c] group-hover:text-white text-[#102a4c] flex items-center justify-center transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <span class="text-xs font-semibold text-slate-700 leading-tight">টাকা<br>উত্তোলন</span>
          </button>

          <button onclick="openModal('certificate-modal')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-11 h-11 rounded-xl bg-slate-100 group-hover:bg-[#102a4c] group-hover:text-white text-[#102a4c] flex items-center justify-center transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15l-2 5l2-1l2 1l-2-5"/><circle cx="12" cy="9" r="5"/></svg>
            </div>
            <span class="text-xs font-semibold text-slate-700 leading-tight">আমাদের<br>সার্টিফিকেট</span>
          </button>

          <button onclick="switchTab('team')" class="flex flex-col items-center gap-1.5 group">
            <div class="w-11 h-11 rounded-xl bg-slate-100 group-hover:bg-[#102a4c] group-hover:text-white text-[#102a4c] flex items-center justify-center transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            </div>
            <span class="text-xs font-semibold text-slate-700 leading-tight">আমন্ত্রণ<br>জানান</span>
          </button>
        </div>

        <!-- Referral 5000 Tk Promo Card -->
        <div onclick="switchTab('team')" class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl p-4 text-white card-shadow flex items-center justify-between cursor-pointer">
          <div>
            <span class="bg-white/20 text-[10px] font-bold px-2 py-0.5 rounded-full">বিশেষ অফার</span>
            <h3 class="font-bold text-base mt-1">১০ জন বন্ধুকে রেফার করুন</h3>
            <p class="text-xs text-amber-50">সাথে সাথে পান <span class="font-bold underline">৫,০০০ টাকা</span> নিশ্চিত বোনাস!</p>
          </div>
          <div class="bg-white text-orange-600 font-bold text-xs px-3 py-2 rounded-xl shadow">
            রেফার করুন
          </div>
        </div>

        <!-- Message Center / Live Updates ("বার্তা কেন্দ্র") -->
        <div class="bg-white rounded-2xl p-4 card-shadow">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-bold text-[#102a4c] text-base">বার্তা কেন্দ্র</h2>
            <button onclick="openModal('task-details-modal')" class="text-xs font-bold text-[#102a4c]">আরও ›</button>
          </div>
          <div class="space-y-2.5">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
              <span class="text-lg">📢</span>
              <div>
                <p class="text-xs font-bold text-slate-800">শুধুমাত্র বিকাশে সেন্ড মানি প্রযোজ্য</p>
                <p class="text-[11px] text-slate-500 mt-0.5">রিচার্জ করার সময় আমাদের অফিশিয়াল বিকাশ নাম্বার <span class="font-bold text-[#102a4c]">01622932025</span> এ সেন্ড মানি করে ট্রানজেকশন আইডি দিন।</p>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
              <span class="text-lg">🎁</span>
              <div>
                <p class="text-xs font-bold text-slate-800">দৈনিক ভিআইপি টাস্ক আনলক করুন</p>
                <p class="text-[11px] text-slate-500 mt-0.5">১,০০০ টাকা থেকে শুরু করে ভিআইপি প্ল্যান কিনে প্রতিদিন ১০০ টাকা থেকে ১,৩৫০ টাকা পর্যন্ত আয় করুন।</p>
              </div>
            </div>
          </div>
        </div>

        <!-- About & Certificate Quick Card -->
        <div class="bg-white rounded-2xl p-4 card-shadow flex items-center justify-between">
          <div>
            <h3 class="font-bold text-sm text-[#102a4c]">BD earning সম্পর্কে জানুন</h3>
            <p class="text-xs text-slate-500 mt-0.5">অফিশিয়াল নিবন্ধন ও অনুমোদিত সার্টিফিকেট দেখুন</p>
          </div>
          <button onclick="openModal('certificate-modal')" class="navy-gradient text-white text-xs font-bold px-3.5 py-2 rounded-xl">
            সার্টিফিকেট
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== TAB 2: TASK (টাস্ক) ==================== -->
    <div id="view-task" class="view-section hidden">
      <div class="bg-white px-4 py-3.5 text-center border-b border-slate-100 sticky top-0 z-30">
        <h1 class="text-base font-bold text-[#102a4c]">জনপ্রিয় ভিআইপি প্ল্যান ও টাস্ক</h1>
      </div>

      <div class="p-4 space-y-4">
        <!-- Active Plan Status Banner -->
        <div class="navy-gradient rounded-2xl p-4 text-white card-shadow">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-white/10 border-2 border-amber-400 flex items-center justify-center font-bold text-amber-400">
                BD
              </div>
              <div>
                <span id="active-plan-badge" class="bg-amber-400 text-[#102a4c] text-[10px] font-bold px-2.5 py-0.5 rounded-full">ফ্রি সদস্য</span>
                <p class="text-xs text-slate-200 mt-1">আজকের টাস্ক আয়: <span id="today-task-earned" class="font-bold text-amber-300">Tk 0</span></p>
              </div>
            </div>
            <button onclick="openModal('task-details-modal')" class="bg-white/15 hover:bg-white/25 text-white text-xs font-semibold px-3 py-1.5 rounded-lg border border-white/20">
              টাস্কের বিবরণ
            </button>
          </div>
        </div>

        <!-- Daily Task Execution Box (For Unlocked VIP Plans) -->
        <div id="active-tasks-container" class="space-y-3"></div>

        <!-- VIP Plans List (Matching Screenshot 4 Card Style) -->
        <div id="vip-plans-list" class="space-y-4"></div>
      </div>
    </div>

    <!-- ==================== TAB 3: TEAM (দল) ==================== -->
    <div id="view-team" class="view-section hidden">
      <div class="bg-white px-4 py-3.5 text-center border-b border-slate-100 sticky top-0 z-30">
        <h1 class="text-base font-bold text-[#102a4c]">দল ও রেফারেল বোনাস</h1>
      </div>

      <div class="p-4 space-y-4">
        <!-- Team Income Summary Card (Matching Screenshot 3) -->
        <div class="bg-white rounded-2xl p-4 card-shadow">
          <h2 class="text-sm font-bold text-[#102a4c] mb-3">টিমের আয় ও সদস্য</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p id="team-bonus-total" class="text-2xl font-bold text-[#102a4c]">Tk 0</p>
              <p class="text-xs text-slate-500">টিমের মোট আয়</p>
            </div>
            <div>
              <p id="team-member-count" class="text-2xl font-bold text-[#102a4c]">0 / 10</p>
              <p class="text-xs text-slate-500">মোট রেফার সদস্য</p>
            </div>
          </div>

          <!-- 10 Friends 5000 Tk Progress Bar -->
          <div class="mt-4 pt-3 border-t border-slate-100">
            <div class="flex justify-between text-xs font-semibold mb-1.5">
              <span class="text-slate-700">১০ জন রেফার টার্গেট (৫,০০০ টাকা বোনাস)</span>
              <span id="ref-progress-text" class="text-emerald-600">০% সম্পন্ন</span>
            </div>
            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
              <div id="ref-progress-bar" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
